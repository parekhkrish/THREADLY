<%- include('partials/header', { title: 'Log In', activePage: 'login' }) %>

<main class="main-content auth-page-layout">
    <div class="auth-card-container">
        <div class="auth-card">
            <div class="auth-header-block">
                <span class="badge-pill sm">
                    <span class="badge-dot blue"></span>
                    <span>Sign In</span>
                </span>
                <h1 class="auth-title">Welcome Back</h1>
                <p class="auth-subtitle">Sign in to your Threadly account to publish and manage thoughts.</p>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger" role="alert">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form method="POST" action="/login" class="auth-form">
                <div class="form-group">
                    <label for="email" class="form-label">
                        <span>Email Address</span>
                        <span class="required-star">*</span>
                    </label>
                    <input id="email" name="email" type="email" placeholder="alex@example.com" autocomplete="email" required class="form-input">
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">
                        <span>Password</span>
                        <span class="required-star">*</span>
                    </label>
                    <input id="password" name="password" type="password" placeholder="••••••••" required class="form-input">
                </div>

                <button type="submit" class="btn btn-primary btn-spark btn-lg w-full">
                    <span>Log In</span>
                </button>

                <div class="auth-footer-text">
                    <span>Don't have an account?</span>
                    <a href="/signup" class="auth-link">Create Account</a>
                </div>
            </form>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
