<%- include('partials/header', { title: 'Community Feed', activePage: 'feed' }) %>

<main class="main-content">
    <!-- Hero Banner -->
    <section class="page-hero">
        <div class="hero-text-container">
            <div class="badge-pill">
                <span class="badge-dot"></span>
                <span>Community Feed</span>
            </div>
            <h1 class="hero-title">Where ideas take flight.</h1>
            <p class="hero-copy">Discover thoughts, stories, and quick updates from creators around the world. Join the conversation, express yourself, and connect with people who share your passion.</p>
            
            <div class="hero-actions">
                <a href="/posts/new" class="btn btn-primary btn-lg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Create a Post</span>
                </a>
                <a href="#feed-anchor" class="btn btn-secondary btn-lg">Explore Feed</a>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon-wrapper cyan">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
                <div>
                    <span class="stat-value"><%= posts.length %></span>
                    <span class="stat-label">Total Posts</span>
                </div>
            </div>

            <% 
                const uniqueAuthors = new Set(posts.map(p => p.username ? p.username.toLowerCase() : 'anonymous')).size;
                const totalWords = posts.reduce((acc, p) => acc + (p.content ? p.content.split(/\s+/).length : 0), 0);
            %>

            <div class="stat-card">
                <div class="stat-icon-wrapper purple">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
                <div>
                    <span class="stat-value"><%= uniqueAuthors %></span>
                    <span class="stat-label">Active Creators</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon-wrapper amber">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                </div>
                <div>
                    <span class="stat-value"><%= totalWords %></span>
                    <span class="stat-label">Words Published</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Feed Header & Controls -->
    <section class="feed-section" id="feed-anchor">
        <div class="feed-header">
            <div class="feed-title-block">
                <span class="section-kicker">Trending Activity</span>
                <h2>Latest Posts</h2>
            </div>
            
            <div class="feed-controls">
                <div class="filter-tabs">
                    <button class="tab-btn active" data-filter="all">All Posts (<%= posts.length %>)</button>
                </div>
            </div>
        </div>

        <!-- Empty State for Search -->
        <div id="search-empty-state" class="empty-state" style="display: none;">
            <div class="empty-icon">🔍</div>
            <h3 class="empty-title">No matching posts found</h3>
            <p>Try searching for a different handle or keyword.</p>
        </div>

        <% if (posts.length === 0) { %>
            <div class="empty-state">
                <div class="empty-icon-wrapper">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </div>
                <h3 class="empty-title">No posts published yet</h3>
                <p>Be the first creator to share a thought or update with the community!</p>
                <a href="/posts/new" class="btn btn-primary btn-spark">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span>Publish First Post</span>
                </a>
            </div>
        <% } else { %>
            <div class="post-grid" aria-label="Posts grid">
                <% for (let post of posts) { 
                    const username = post.username || (post.author ? post.author.username : 'Anonymous');
                    const initial = username.charAt(0).toUpperCase();
                    let hash = 0;
                    for (let i = 0; i < username.length; i++) {
                        hash = username.charCodeAt(i) + ((hash << 5) - hash);
                    }
                    const hue = Math.abs(hash) % 360;
                    const wordCount = post.content ? post.content.trim().split(/\s+/).length : 0;
                    const formattedDate = post.createdAt ? new Date(post.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recent';
                    const postIdStr = post._id ? post._id.toString() : post.id.toString();
                    
                    const isPostAuthor = typeof currentUser !== 'undefined' && currentUser && post.author && (post.author._id ? post.author._id.toString() : post.author.toString()) === currentUser._id.toString();
                    const canModify = typeof currentUser !== 'undefined' && currentUser && (isAdmin || isPostAuthor);
                    const isAuthorAdmin = post.author && post.author.role === 'admin';
                %>
                    <article class="post-card">
                        <div class="post-card-header">
                            <div class="avatar" style="--avatar-hue: <%= hue %>deg">
                                <span><%= initial %></span>
                            </div>
                            <div class="user-meta">
                                <div class="username-wrapper">
                                    <h3 class="username">@<%= username %></h3>
                                    <span class="verified-badge">✓</span>
                                    <% if (isAuthorAdmin) { %>
                                        <span class="role-badge role-admin" style="font-size: 0.62rem;">ADMIN</span>
                                    <% } %>
                                </div>
                                <div class="post-submeta">
                                    <span class="post-date"><%= formattedDate %></span>
                                    <span class="dot-separator">•</span>
                                    <span class="read-time"><%= wordCount %> words</span>
                                </div>
                            </div>

                            <% if (canModify) { %>
                                <div class="post-menu">
                                    <a href="/posts/<%= postIdStr %>/edit" class="icon-btn" title="Edit Post">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </a>
                                </div>
                            <% } %>
                        </div>

                        <div class="post-body">
                            <p class="content"><%= post.content %></p>
                        </div>

                        <div class="card-footer">
                            <div class="post-id-badge">
                                <span class="id-label">REF</span>
                                <code class="id-code">#<%= postIdStr.slice(-6) %></code>
                            </div>

                            <div class="card-actions">
                                <% if (canModify) { %>
                                    <form method="POST" action="/posts/<%= postIdStr %>/delete" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this post?');">
                                        <button type="submit" class="text-btn danger" title="Delete post">Delete</button>
                                    </form>
                                <% } %>
                                <a href="/posts/<%= postIdStr %>" class="btn btn-sm btn-outline">
                                    <span>Read</span>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                <% } %>
            </div>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>
