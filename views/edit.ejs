<%- include('partials/header', { title: 'Edit Post — @' + (post.username || 'Anonymous') }) %>

<main class="main-content form-page-layout">
    <% const postIdStr = post._id ? post._id.toString() : post.id.toString(); %>
    <div class="composer-container">
        <!-- Left: Edit Form Panel -->
        <div class="composer-form-section">
            <div class="form-header-block">
                <a href="/posts/<%= postIdStr %>" class="back-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Cancel & Back</span>
                </a>
                <span class="badge-pill sm amber">
                    <span class="badge-dot amber"></span>
                    <span>Editor</span>
                </span>
                <h1 class="form-title">Edit Post</h1>
                <p class="form-subtitle">Update your existing post and refine your content.</p>
            </div>

            <form method="POST" action="/posts/<%= postIdStr %>?_method=PATCH" class="post-form" id="edit-post-form">
                <div class="form-group">
                    <label for="username" class="form-label">
                        <span>Author Handle</span>
                        <span class="required-star">*</span>
                    </label>
                    <div class="input-prefix-wrapper">
                        <span class="input-prefix">@</span>
                        <input id="username" name="username" type="text" value="<%= post.username %>" required maxlength="30" class="form-input">
                    </div>
                </div>

                <div class="form-group">
                    <div class="label-with-counter">
                        <label for="content" class="form-label">
                            <span>Post Content</span>
                            <span class="required-star">*</span>
                        </label>
                        <span class="char-counter" id="char-counter"><%= post.content ? post.content.length : 0 %> / 500</span>
                    </div>
                    <textarea id="content" name="content" rows="6" required maxlength="500" class="form-textarea"><%= post.content %></textarea>
                    <div class="form-meta-row">
                        <span class="form-help">Edit text or code details.</span>
                        <span class="word-counter" id="word-counter"><%= post.content ? post.content.trim().split(/\s+/).length : 0 %> words</span>
                    </div>
                </div>

                <div class="form-actions-row">
                    <a href="/posts/<%= postIdStr %>" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary btn-spark btn-lg">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>Save Changes</span>
                    </button>
                </div>
            </form>
        </div>

        <!-- Right: Live Preview Panel -->
        <div class="composer-preview-section">
            <div class="preview-header">
                <span class="preview-badge">Live Update Preview</span>
                <span class="preview-hint">Shows live modifications</span>
            </div>

            <% 
                const username = post.username || 'Anonymous';
                const initial = username.charAt(0).toUpperCase();
                let hash = 0;
                for (let i = 0; i < username.length; i++) {
                    hash = username.charCodeAt(i) + ((hash << 5) - hash);
                }
                const hue = Math.abs(hash) % 360;
                const wordCount = post.content ? post.content.trim().split(/\s+/).length : 0;
            %>

            <div class="preview-card-wrapper">
                <article class="post-card preview-card">
                    <div class="post-card-header">
                        <div class="avatar" id="preview-avatar" style="--avatar-hue: <%= hue %>deg">
                            <span id="preview-initial"><%= initial %></span>
                        </div>
                        <div class="user-meta">
                            <div class="username-wrapper">
                                <h3 class="username" id="preview-username">@<%= username %></h3>
                                <span class="verified-badge">✓</span>
                            </div>
                            <div class="post-submeta">
                                <span class="post-date">Editing</span>
                                <span class="dot-separator">•</span>
                                <span class="read-time" id="preview-word-count"><%= wordCount %> words</span>
                            </div>
                        </div>
                    </div>

                    <div class="post-body">
                        <p class="content" id="preview-content"><%= post.content %></p>
                    </div>

                    <div class="card-footer">
                        <div class="post-id-badge">
                            <span class="id-label">REF</span>
                            <code class="id-code">#<%= postIdStr.slice(-6) %></code>
                        </div>

                        <div class="card-actions">
                            <span class="preview-status editing">Editing State</span>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const usernameInput = document.getElementById('username');
        const contentInput = document.getElementById('content');
        
        const previewUsername = document.getElementById('preview-username');
        const previewInitial = document.getElementById('preview-initial');
        const previewAvatar = document.getElementById('preview-avatar');
        const previewContent = document.getElementById('preview-content');
        const previewWordCount = document.getElementById('preview-word-count');
        
        const charCounter = document.getElementById('char-counter');
        const wordCounter = document.getElementById('word-counter');

        function updatePreview() {
            const usernameVal = usernameInput.value.trim() || 'username';
            const contentVal = contentInput.value.trim();

            previewUsername.textContent = '@' + usernameVal;
            previewInitial.textContent = usernameVal.charAt(0).toUpperCase() || 'U';

            let hash = 0;
            for (let i = 0; i < usernameVal.length; i++) {
                hash = usernameVal.charCodeAt(i) + ((hash << 5) - hash);
            }
            const hue = Math.abs(hash) % 360;
            previewAvatar.style.setProperty('--avatar-hue', `${hue}deg`);

            previewContent.textContent = contentVal || 'No content provided...';

            const charCount = contentInput.value.length;
            const words = contentVal ? contentVal.split(/\s+/).filter(Boolean).length : 0;

            charCounter.textContent = `${charCount} / 500`;
            wordCounter.textContent = `${words} ${words === 1 ? 'word' : 'words'}`;
            previewWordCount.textContent = `${words} ${words === 1 ? 'word' : 'words'}`;
        }

        usernameInput.addEventListener('input', updatePreview);
        contentInput.addEventListener('input', updatePreview);
    });
</script>

<%- include('partials/footer') %>
